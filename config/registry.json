    "safe": true
  },

  "get_screen_brightness": {
    "endpoint": "/device/getScreenBrightness",
    "description": "Get the current screen brightness level",
    "parameters": {},
    "response": {
      "success": { "type": "boolean", "required": true },
      "brightness": { "type": "number", "required": true, "description": "Current brightness 0-255" }
    },
    "safe": true
  },

  "set_dark_mode": {
    "endpoint": "/device/setDarkMode",
    "description": "Enable or disable system dark mode",
    "parameters": {
      "enabled": { "type": "boolean", "required": true, "description": "true = dark mode on, false = light mode" }
    },
    "response": {
      "success": { "type": "boolean", "required": true },
      "dark_mode": { "type": "boolean", "description": "New dark mode state" }
    },
    "safe": true
  },

  "get_dark_mode": {
    "endpoint": "/device/getDarkMode",
    "description": "Get current dark mode state",
    "parameters": {},
    "response": {
      "success": { "type": "boolean", "required": true },
      "dark_mode": { "type": "boolean", "required": true, "description": "true if dark mode is enabled" }
    },
    "safe": true
  },

  "volume_mute": {
    "endpoint": "/device/mute",
    "description": "Mute or unmute device media volume",
    "parameters": {
      "mute": { "type": "boolean", "default": true, "description": "true to mute, false to unmute" }
    },
    "response": {
      "success": { "type": "boolean", "required": true },
