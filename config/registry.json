{
  "get_device_snapshot": {
    "endpoint": "/device/getDeviceSnapshot",
    "description": "Get device state with UI nodes. Returns snapshot with screen_width, screen_height, foreground_package, ui_nodes. Compact mode: each node has {text, desc, hint, class, bounds:{cx,cy,...}, clickable, focused, editable, scrollable...} - only non-empty/true values.",
    "parameters": {
      "compact": { "type": "boolean", "default": true, "description": "Use compact node format (default true)" }
    },
    "response": {
      "success": { "type": "boolean", "required": true },
      "snapshot": {
        "type": "object",
        "properties": {
          "screen_width": { "type": "number" },
          "screen_height": { "type": "number" },
          "foreground_package": { "type": "string" },
          "flashlight_status": { "type": "string", "description": "Flashlight state: 'on', 'off', or error message" },
          "is_statusbar_enabled": { "type": "boolean", "description": "Whether status bar is enabled" },
          "is_muted": { "type": "boolean", "description": "Whether device volume is muted" },
          "all_sensors": { "type": "object", "description": "All sensor data (accelerometer, gyroscope, light, proximity, etc.)" },
          "ui_nodes": { "type": "object", "description": "{count, nodes:[{text,desc,class,bounds:{cx,cy},clickable,focused,editable}...]}" }
        }
      }
    },
    "notes": "Use bounds.cx, bounds.cy from nodes for tap coordinates."
  },

  "get_all_sensors": {
    "endpoint": "/device/getAllSensors",
    "description": "Get all sensor data from device (accelerometer, gyroscope, light, proximity, magnetic field, etc.)",
    "parameters": {},
    "response": {
      "success": { "type": "boolean", "required": true },
      "sensors": { "type": "object", "description": "Object with sensor type keys and their latest values" }
    }
  },

  "screen_analyze": {
    "endpoint": "/device/opencvAnalyzeScreen",
    "description": "Analyze screen using OpenCV: OCR text detection and UI element detection. Use this when get_device_snapshot ui_nodes are not enough and you need to find text or UI elements by visual analysis. This is slower than get_device_snapshot.",
    "parameters": {
      "detectText": { "type": "boolean", "default": true, "description": "Enable OCR text detection" },
      "detectContours": { "type": "boolean", "default": true, "description": "Enable UI element contour detection" },
      "classifyElements": { "type": "boolean", "default": true, "description": "Classify detected elements (button, input, etc.)" }
    },
    "response": {
      "success": { "type": "boolean", "required": true },
      "analysis": {
        "type": "object",
        "description": "Screen analysis results",
        "properties": {
          "screenWidth": { "type": "number", "description": "Screen width" },
          "screenHeight": { "type": "number", "description": "Screen height" },
          "textCount": { "type": "number", "description": "Number of text elements found" },
          "uiCount": { "type": "number", "description": "Number of UI elements found" },
          "textElements": { "type": "array", "description": "Array of detected text with bounds and center coordinates" },
          "uiElements": { "type": "array", "description": "Array of detected UI elements with bounds and center coordinates" }
        }
      }
    },
    "notes": "Use when you need to find text on screen that is not in accessibility nodes. Each textElement has: text, bounds, center, confidence."
  },

  "go_home": {
    "endpoint": "/device/goHome",
    "description": "Navigate to Android home screen using global action",
    "parameters": {},
    "response": {
      "success": { "type": "boolean", "required": true, "description": "Whether navigation succeeded" },
      "action": { "type": "string", "description": "Action name echoed back" }
    }
  },

  "press_back": {
    "endpoint": "/device/pressBack",
    "description": "Press the back button using global action",
    "parameters": {},
    "response": {
      "success": { "type": "boolean", "required": true, "description": "Whether back press succeeded" }
    }
  },

  "press_home": {
    "endpoint": "/device/pressHome",
    "description": "Press the home button using global action",
    "parameters": {},
    "response": {
      "success": { "type": "boolean", "required": true, "description": "Whether home press succeeded" }
    }
  },

  "press_recent": {
    "endpoint": "/device/pressRecent",
    "description": "Open recent apps / app switcher using global action",
    "parameters": {},
    "response": {
      "success": { "type": "boolean", "required": true, "description": "Whether recent apps opened" }
    }
  },

  "press_enter": {
    "endpoint": "/device/pressEnter",
    "description": "Press enter/submit key. Use after typing in search fields to submit the query.",
    "parameters": {},
    "response": {
      "success": { "type": "boolean", "required": true, "description": "Whether enter was pressed" }
    }
  },

  "run_app": {
    "endpoint": "/device/runApp",
    "description": "Launch an app by package name. Use wait_for_open_ms to wait until app reaches foreground.",
    "parameters": {
      "package_name": { "type": "string", "required": true, "description": "Android package name (e.g., com.android.chrome)" },
      "wait_for_open_ms": { "type": "number", "default": 3000, "description": "Time to wait for app to reach foreground (recommended: 3000)" },
      "activity": { "type": "string", "description": "Specific activity to launch (optional)" }
    },
    "response": {
      "success": { "type": "boolean", "required": true, "description": "Whether app launched successfully" },
      "data": {
        "type": "object",
        "description": "Launch result details",
        "properties": {
          "package": { "type": "string", "description": "Package that was launched" },
          "activity": { "type": "string", "description": "Activity that was launched" },
          "appInForeground": { "type": "boolean", "description": "Whether app is now in foreground" },
          "waitTimeMs": { "type": "number", "description": "Actual time waited" }
        }
      }
    }
  },

  "close_app": {
    "endpoint": "/device/closeApp",
    "description": "Close an app gracefully by sending it to background",
    "parameters": {
      "package_name": { "type": "string", "required": true, "description": "Package name to close" }
    },
    "response": {
      "success": { "type": "boolean", "required": true, "description": "Whether app was closed" }
    }
  },

  "close_all_apps": {
    "endpoint": "/device/closeAllApps",
    "description": "Close all running apps (clears recent apps)",
    "parameters": {},
    "response": {
      "success": { "type": "boolean", "required": true }
    }
  },

  "force_stop_app": {
    "endpoint": "/device/forceStopApp",
    "description": "Force stop an app immediately (kills all its processes)",
    "parameters": {
      "package": { "type": "string", "required": true, "description": "Package name to force stop" }
    },
    "response": {
      "success": { "type": "boolean", "required": true, "description": "Whether app was force stopped" }
    }
  },

  "input_tap": {
    "endpoint": "/device/performTap",
    "description": "Tap at specific screen coordinates. Use EXACT coordinates from get_device_snapshot observation. CRITICAL: NEVER tap outside the device screen. Valid bounds: 0 <= x < screen_width and 0 <= y < screen_height (from the latest snapshot).",
    "parameters": {
      "x": { "type": "number", "required": true, "description": "X coordinate in pixels. MUST satisfy 0 <= x < screen_width." },
      "y": { "type": "number", "required": true, "description": "Y coordinate in pixels. MUST satisfy 0 <= y < screen_height." },
      "duration_ms": { "type": "number", "default": 100, "description": "Tap duration in ms. Use 500+ for long-press." },
      "draw_tap": { "type": "boolean", "default": false, "description": "draw a tap overlay on screen for visual debugging" }
    },
    "response": {
      "success": { "type": "boolean", "required": true, "description": "Whether tap was performed" }
    }
  },

  "input_swipe": {
    "endpoint": "/device/performSwipe",
    "description": "Swipe from point A to point B. CRITICAL: NEVER swipe outside the device screen. All coordinates MUST satisfy 0 <= x < screen_width and 0 <= y < screen_height (from the latest snapshot). For SCROLL DOWN (see content below): start high (y1), end low (y2). For SCROLL UP: start low, end high.",
    "parameters": {
      "x1": { "type": "number", "required": true, "description": "Start X coordinate in pixels. MUST be within [0, screen_width)." },
      "y1": { "type": "number", "required": true, "description": "Start Y coordinate in pixels. MUST be within [0, screen_height)." },
      "x2": { "type": "number", "required": true, "description": "End X coordinate in pixels. MUST be within [0, screen_width)." },
      "y2": { "type": "number", "required": true, "description": "End Y coordinate in pixels. MUST be within [0, screen_height)." },
      "duration_ms": { "type": "number", "default": 300, "description": "Swipe duration (longer = slower swipe)" }
    },
    "response": {
      "success": { "type": "boolean", "required": true, "description": "Whether swipe was performed" }
    }
  },

  "input_scroll": {
    "endpoint": "/device/performScroll",
    "description": "Scroll at a specific location using scroll events (like mouse wheel). CRITICAL: NEVER scroll outside the device screen. Coordinates MUST be within bounds from the latest get_device_snapshot (0 <= x < screen_width, 0 <= y < screen_height).",
    "parameters": {
      "x": { "type": "number", "required": true, "description": "Scroll center X coordinate in pixels. MUST be within [0, screen_width)." },
      "y": { "type": "number", "required": true, "description": "Scroll center Y coordinate in pixels. MUST be within [0, screen_height)." },
      "ticks": { "type": "number", "default": 400, "minimum": 50, "maximum": 1000, "description": "Scroll amount in PIXELS (not steps!). Use 300-500 for normal scroll. Positive=up, Negative=down. Example: -400 to scroll down. NEVER use small values like -3!" }
    },
    "response": {
      "success": { "type": "boolean", "required": true, "description": "Whether scroll was performed" }
    }
  },

  "type_text": {
    "endpoint": "/device/typeText",
    "description": "Type text into the CURRENTLY FOCUSED input field. IMPORTANT: You MUST tap on an input field first to focus it before using this command! IMPORTANT: always use enable_adb_keyboard before typing to ensure the virtual keyboard is hidden and will not interfere.",
    "parameters": {
      "text": { "type": "string", "required": true, "description": "Text to type (supports Unicode)" },
      "delay_ms": { "type": "number", "default": 50, "description": "Delay between characters in ms" }
    },
    "response": {
      "success": { "type": "boolean", "required": true, "description": "Whether text was typed" },
      "typed_length": { "type": "number", "description": "Number of characters typed" }
    }
  },

  "clear_text": {
    "endpoint": "/device/clearText",
    "description": "Clear text from the currently focused input field",
    "parameters": {},
    "response": {
      "success": { "type": "boolean", "required": true, "description": "Whether text was cleared" }
    }
  },

  "enable_adb_keyboard": {
    "endpoint": "/device/enableAdbKeyboard",
    "description": "Enable ADB keyboard for text input. Use this if type_text doesn't work properly.",
    "parameters": {},
    "response": {
      "success": { "type": "boolean", "required": true },
      "message": { "type": "string", "description": "Error message if failed" }
    }
  },

  "disable_adb_keyboard": {
    "endpoint": "/device/disableAdbKeyboard",
    "description": "Disable ADB keyboard and restore default keyboard",
    "parameters": {},
    "response": {
      "success": { "type": "boolean", "required": true },
      "message": { "type": "string", "description": "Error message if failed" }
    }
  },

  "get_adb_keyboard_status": {
    "endpoint": "/device/getAdbKeyboardStatus",
    "description": "Get ADB keyboard installation and status info",
    "parameters": {},
    "response": {
      "package_name": { "type": "string", "description": "ADB keyboard package name" },
      "installed": { "type": "boolean", "description": "Whether ADB keyboard is installed" },
      "enabled": { "type": "boolean", "description": "Whether ADB keyboard is currently enabled" },
      "default_input_method": { "type": "string", "description": "Current default input method" },
      "permitted_input_methods": { "type": "string", "description": "Comma-separated list of permitted input methods" }
    }
  },

  "wait": {
    "endpoint": null,
    "description": "Wait for UI to update. Handled locally (not sent to device). Use after actions that change the screen.",
    "parameters": {
      "ms": { "type": "number", "default": 1000, "description": "Milliseconds to wait" }
    },
    "response": {
      "success": { "type": "boolean", "required": true },
      "waited_ms": { "type": "number", "description": "Actual ms waited" }
    },
    "local": true
  },

  "vibrate_device": {
    "endpoint": "/device/vibrateDevice",
