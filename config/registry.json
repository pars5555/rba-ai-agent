      "success": { "type": "boolean", "required": true, "description": "Whether vibration started" }
    }
  },

  "toast": {
    "endpoint": "/device/toast",
    "description": "Show a toast message on the device screen",
    "parameters": {
      "message": { "type": "string", "required": true, "description": "Message to display" },
