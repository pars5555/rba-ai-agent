  },

  "disable_status_bar": {
    "endpoint": "/device/disableStatusBar",
    "description": "Lock/disable status bar to prevent accidental pull-down during automation",
    "parameters": {},
    "response": {
      "success": { "type": "boolean", "required": true }
    },
    "safe": true
  },

  "enable_status_bar": {
    "endpoint": "/device/enableStatusBar",
    "description": "Re-enable status bar after disabling it",
    "parameters": {},
    "response": {
      "success": { "type": "boolean", "required": true }
    },
    "safe": true
  },

  "clear_app_cache": {
    "endpoint": "/device/clearAppCache",
    "description": "Clear cached data for a specific app",
    "parameters": {
      "package": { "type": "string", "required": true, "description": "Package name of app to clear cache" }
    },
    "response": {
      "success": { "type": "boolean", "required": true }
    },
    "safe": true
  },

  "draw_rect": {
    "endpoint": "/device/drawRect",
    "description": "Draw a rectangle overlay on screen for visual debugging",
    "parameters": {
      "left": { "type": "number", "required": true, "description": "Left edge X coordinate" },
      "top": { "type": "number", "required": true, "description": "Top edge Y coordinate" },
      "right": { "type": "number", "required": true, "description": "Right edge X coordinate" },
      "bottom": { "type": "number", "required": true, "description": "Bottom edge Y coordinate" },
      "color": { "type": "string", "default": "#FF0000", "description": "Color in hex format" },
      "strokeWidth": { "type": "number", "default": 4, "description": "Line thickness" },
      "durationMs": { "type": "number", "default": 3000, "description": "How long to show overlay" }
    },
    "response": {
      "success": { "type": "boolean", "required": true }
    },
    "safe": true
  },

  "draw_circle": {
    "endpoint": "/device/drawCircle",
    "description": "Draw a circle overlay on screen for visual debugging",
    "parameters": {
      "centerX": { "type": "number", "required": true, "description": "Circle center X coordinate" },
      "centerY": { "type": "number", "required": true, "description": "Circle center Y coordinate" },
      "radius": { "type": "number", "default": 50, "description": "Circle radius in pixels" },
      "color": { "type": "string", "default": "#00FF00", "description": "Color in hex format" },
      "strokeWidth": { "type": "number", "default": 4, "description": "Line thickness" },
      "durationMs": { "type": "number", "default": 3000, "description": "How long to show overlay" }
    },
    "response": {
      "success": { "type": "boolean", "required": true }
    },
    "safe": true
  },

  "clear_overlays": {
    "endpoint": "/device/clearOverlays",
    "description": "Clear all debug overlays from screen",
    "parameters": {},
    "response": {
      "success": { "type": "boolean", "required": true }
    },
    "safe": true
  }
}
