    },
    "response": {
      "success": { "type": "boolean", "required": true },
      "muted": { "type": "boolean", "description": "Current mute state" }
    }
  },

  "disable_status_bar": {
    "endpoint": "/device/disableStatusBar",
    "description": "Lock/disable status bar to prevent accidental pull-down during automation",
    "parameters": {},
    "response": {
      "success": { "type": "boolean", "required": true }
    }
  },

  "enable_status_bar": {
    "endpoint": "/device/enableStatusBar",
    "description": "Re-enable status bar after disabling it",
    "parameters": {},
    "response": {
      "success": { "type": "boolean", "required": true }
    }
  },

  "enable_flashlight": {
