      "top": { "type": "number", "required": true, "description": "Top edge Y coordinate" },
      "right": { "type": "number", "required": true, "description": "Right edge X coordinate" },
      "bottom": { "type": "number", "required": true, "description": "Bottom edge Y coordinate" },
      "color": { "type": "string", "default": "#FF0000", "description": "Color in hex format" },
      "strokeWidth": { "type": "number", "default": 4, "description": "Line thickness" },
      "durationMs": { "type": "number", "default": 3000, "description": "How long to show overlay" }
    },
    "response": {
      "success": { "type": "boolean", "required": true }
    }
  },

  "draw_circle": {
    "endpoint": "/device/drawCircle",
    "description": "Draw a circle overlay on screen for visual debugging",
    "parameters": {
      "centerX": { "type": "number", "required": true, "description": "Circle center X coordinate" },
      "centerY": { "type": "number", "required": true, "description": "Circle center Y coordinate" },
      "radius": { "type": "number", "default": 50, "description": "Circle radius in pixels" },
      "color": { "type": "string", "default": "#00FF00", "description": "Color in hex format" },
      "strokeWidth": { "type": "number", "default": 4, "description": "Line thickness" },
      "durationMs": { "type": "number", "default": 3000, "description": "How long to show overlay" }
    },
    "response": {
      "success": { "type": "boolean", "required": true }
