    }
  },

  "get_screenshot": {
    "endpoint": "/device/hidden/getScreenshot",
    "description": "Get a screenshot as base64 JPEG. Usually not needed - use get_device_snapshot instead for structured data.",
    "parameters": {
      "quality": { "type": "number", "default": 80, "description": "JPEG quality 1-100 (higher = better quality, larger size)" }
    },
    "response": {
      "success": { "type": "boolean", "required": true },
      "data": { "type": "string", "description": "Base64 encoded JPEG image" },
      "width": { "type": "number", "description": "Image width" },
      "height": { "type": "number", "description": "Image height" }
    }
  },

  "set_screen_brightness": {
