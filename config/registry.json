  "clear_overlays": {
    "endpoint": "/device/clearOverlays",
    "description": "Clear all debug overlays from screen",
    "parameters": {},
    "response": {
      "success": { "type": "boolean", "required": true }
    }
  },
  "speak": {
    "endpoint": "/device/speak",
    "description": "Text-to-speech - speak text aloud on device. Automatically stops any ongoing speech first.",
    "parameters": {
      "text": {
        "type": "string",
        "required": true,
        "description": "Text to speak"
      },
      "language": {
        "type": "string",
        "default": "en",
        "description": "Language code (en, ru, etc.)"
      },
      "pitch": {
        "type": "number",
        "default": 1,
        "description": "Voice pitch (0.5-2.0)"
      },
      "speed": {
        "type": "number",
        "default": 1,
        "description": "Speech rate (0.5-2.0)"
      }
    },
    "response": {
      "success": { "type": "boolean", "required": true },
      "message": { "type": "string", "description": "Status message" }
    }
  },
  "stop_speech": {
    "endpoint": "/device/stopSpeech",
    "description": "Stop any ongoing text-to-speech playback.",
    "parameters": {},
    "response": {
      "success": { "type": "boolean", "required": true },
      "message": { "type": "string", "description": "Status message" }
    }
  }
}
